# Copy this file to `.env` in the same folder (server/.env) and adjust as needed.
# server/.env is git-ignored — never commit real secrets.

# Port the Express + Socket.IO server listens on.
PORT=4000

# Origin allowed to call the API / connect via Socket.IO (the Vite dev server by default).
CLIENT_ORIGIN=http://localhost:5173

# REQUIRED. PostgreSQL connection string used by Prisma (server/prisma/schema.prisma).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# See README.md "Database (PostgreSQL + Prisma)" for how to create the local dev
# database (native Postgres install, or the committed docker-compose.yml).
DATABASE_URL="postgresql://postgres@localhost:5432/english_platform_dev?schema=public"

# REQUIRED. Secret used to sign/verify JWTs (auth lands in T-005 but is validated at
# startup from now on so config problems fail fast instead of surfacing mid-feature).
# Generate a real value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Optional. Credentials used by `npm run seed -w server` (server/prisma/seed.ts) to
# create the one teacher account for local dev (T-005 — there is no public teacher
# self-registration). If unset, the seed script falls back to documented dev-only
# defaults and prints whichever credentials it actually used.
SEED_TEACHER_EMAIL="teacher@example.com"
SEED_TEACHER_PASSWORD="teacher-dev-password123"
SEED_TEACHER_NAME="Demo Teacher"

# Optional. A SECOND seeded teacher account, used purely as a cross-teacher-isolation
# fixture for T-008 (proving teacher A can't edit teacher B's test). No demo test is
# seeded for this one.
SEED_TEACHER_2_EMAIL="teacher2@example.com"
SEED_TEACHER_2_PASSWORD="teacher2-dev-password123"
SEED_TEACHER_2_NAME="Demo Teacher Two"

# Optional. Selects the Speaking-answer AI grading implementation (T-051,
# server/src/grading/index.ts). Defaults to "mock" (MockAIGradingProvider — a documented
# word-count + keyword-overlap heuristic, no API key needed) when unset. There is
# currently no other implemented value — see docs/INTEGRATIONS_TODO.md for what a real
# provider (e.g. Anthropic) would need and where to register it.
AI_GRADING_PROVIDER=mock

# Optional. Selects the Essay/Writing AI grading implementation (2026-09,
# server/src/grading/index.ts). Defaults to "mock" (MockEssayGradingProvider — a
# documented heuristic, no API key needed) when unset. Set to "anthropic" to use
# AnthropicEssayGradingProvider, which grades against a genuine condensed IELTS Writing
# band-descriptor prompt (Task Achievement/Response, Coherence & Cohesion, Lexical
# Resource, Grammatical Range & Accuracy) — requires ANTHROPIC_API_KEY below. See
# docs/INTEGRATIONS_TODO.md for full activation steps.
ESSAY_GRADING_PROVIDER=mock

# Required only when ESSAY_GRADING_PROVIDER=anthropic. Anthropic API key used by
# AnthropicEssayGradingProvider (server/src/grading/anthropicEssayGradingProvider.ts).
# Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=
