# Copy this file to `.env` in the same folder (server/.env) and adjust as needed.
# server/.env is git-ignored — never commit real secrets.

# Port the Express + Socket.IO server listens on.
PORT=4000

# Origin allowed to call the API / connect via Socket.IO (the Vite dev server by default).
CLIENT_ORIGIN=http://localhost:5173

# REQUIRED. PostgreSQL connection string used by Prisma (server/prisma/schema.prisma).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# See README.md "Database (PostgreSQL + Prisma)" for how to create the local dev
# database (native Postgres install, or the committed docker-compose.yml).
DATABASE_URL="postgresql://postgres@localhost:5432/english_platform_dev?schema=public"

# REQUIRED. Secret used to sign/verify JWTs (auth lands in T-005 but is validated at
# startup from now on so config problems fail fast instead of surfacing mid-feature).
# Generate a real value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
