// Prisma schema for the English Test Platform (server).
//
// Scope note (T-002): originally this file only defined `User`. T-007 adds the
// Test/Section/Question/Choice domain model (see below). T-021 adds the
// Flashcard/Vocabulary domain model. Grammar/Speaking are still owned by their own
// later backlog tasks and must NOT be added here ahead of time. T-074 (Phase 12) adds
// the `Class` entity + `User.classId` — see `Class`'s own doc comment for the full
// class-based-organization design (PROJECT_PLAN Assumption A14). Content-to-class
// assignment (many-to-many join tables per content type) is explicitly T-075's job, NOT
// this task's — nothing here gives `Test`/`FlashcardSet`/`GrammarTopic` a class FK.

generator client {
  provider   = "prisma-client-js"
  // "binary" (a separate query-engine subprocess per client instance) instead of the
  // default "library" (an in-process native .node addon) — documented workaround for a
  // Windows-only multi-agent dev annoyance: several long-running `tsx watch` dev-server
  // processes (started by other concurrent agents working this same tree) keep the
  // default engine's .dll.node file memory-mapped/loaded for their entire lifetime,
  // which makes Windows refuse to overwrite it on every subsequent `prisma generate` —
  // even though none of those processes need this specific regeneration. The "binary"
  // engine writes to a differently-named executable each version instead of rewriting
  // one shared locked file in place, so `prisma generate` succeeds regardless of what
  // other agents' dev servers already have loaded. No behavior change for the app itself.
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The account roles defined by TECH_STACK.md, extended 2026-09-15 (T-069, Phase 11,
/// PROJECT_PLAN Assumption A12) with `admin`. Mirrors the `UserRole` type already
/// exported from `@platform/shared` — kept as a separate Prisma enum because Prisma
/// enums can't import a TS union, but the string values match exactly so mapping
/// between them is a no-op.
enum Role {
  teacher
  student
  /// One seeded account only (`admin@example.com` / `123456`, Assumption A12). Bypasses
  /// every per-teacher ownership check in the system rather than owning a separate
  /// parallel data set — see `server/src/lib/authz.ts`'s `isAdminOrOwner` for the single
  /// shared rule every ownership-check helper (`ownedTest.ts`, `ownedFlashcardSet.ts`,
  /// `ownedGrammarTopic.ts`, ...) applies.
  admin
}

/// Base account for both teachers and students. Per PROJECT_PLAN Assumption A1,
/// teacher accounts are created via a seed/admin script (T-005), never through
/// public registration; that logic lives in T-005, not here.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  name         String
  createdAt    DateTime @default(now())

  // A teacher's authored tests. Nothing at the DB layer stops a `student`-role user
  // from being the FK target here — the app layer (T-005 role middleware, T-008
  // authoring endpoints) is what actually restricts test creation to teachers.
  tests Test[] @relation("TeacherTests")

  // A student's test attempts (T-011). Nothing at the DB layer stops a `teacher`-role
  // user from being the FK target here either — the join endpoint's `requireRole('student')`
  // is what actually enforces "students only" for joining a session.
  attempts Attempt[] @relation("StudentAttempts")

  // A teacher's authored flashcard sets (T-022). Same "app layer enforces the role, not
  // the FK" note as `tests` above.
  flashcardSets FlashcardSet[] @relation("TeacherFlashcardSets")

  // A student's per-card vocabulary progress (T-021/T-023). Same note as `attempts`.
  flashcardProgress FlashcardProgress[] @relation("StudentFlashcardProgress")

  // A student's "use it in a sentence" submissions (T-029). Same note as `attempts`.
  vocabSentenceSubmissions VocabSentenceSubmission[] @relation("StudentVocabSentenceSubmissions")

  // A student's per-attempt vocabulary exercise/activity log (T-030). Same note as
  // `attempts` above.
  flashcardExerciseAttempts FlashcardExerciseAttempt[] @relation("StudentFlashcardExerciseAttempts")

  // A teacher's authored Grammar topics (T-046). Same "app layer enforces the role, not
  // the FK" note as `tests`/`flashcardSets` above.
  grammarTopics GrammarTopic[] @relation("TeacherGrammarTopics")

  // A student's per-attempt Grammar exercise log (T-048). Same note as
  // `flashcardExerciseAttempts` above.
  grammarExerciseAttempts GrammarExerciseAttempt[] @relation("StudentGrammarExerciseAttempts")

  // A student's individually-granted access to specific tests (T-038 Vocabulary Check) —
  // see `TestAssignment`'s doc comment. Same "app layer enforces the role, not the FK"
  // note as `attempts` above.
  testAssignments TestAssignment[] @relation("StudentTestAssignments")

  // A teacher's owned classes (T-074, Phase 12). Same "app layer enforces the role, not
  // the FK" note as `tests`/`flashcardSets` above — nothing at the DB layer stops a
  // student-role user from being the FK target.
  classes Class[] @relation("TeacherClasses")

  // The single class this student belongs to for their whole lifetime (T-074, Phase 12,
  // PROJECT_PLAN Assumption A14) — meaningful for `student`-role users only; always
  // `null` for `teacher`/`admin` accounts (nothing in this batch's routes ever sets it
  // for those roles). `SetNull` on delete: `Class`'s own DELETE route already blocks
  // deleting a class that still has students assigned (see `Class`'s doc comment below),
  // so this cascade is a defensive DB-level fallback for that invariant, not the primary
  // enforcement — a student should never be left silently referencing a deleted row.
  classId String?
  class   Class?  @relation("ClassStudents", fields: [classId], references: [id], onDelete: SetNull)

  @@map("users")
}

// --- Class-based organization (T-074, Phase 12) --------------------------------------
// A teacher's cohort/section (e.g. "Lớp 6A"). See PROJECT_PLAN Assumption A14 for the
// full design this and every later Phase-12 task builds on: a student belongs to exactly
// ONE class for their whole lifetime (set at registration, changeable later only by a
// teacher/admin — no self-service switching, no multi-class membership); a class belongs
// to exactly one owning teacher (no co-teaching). Content (`Test`/`FlashcardSet`/
// `GrammarTopic`) is explicitly NOT owned by a class — that stays teacher-owned exactly
// as today, with class-scoped VISIBILITY added later via a many-to-many assignment join
// (T-075), never a hard ownership FK here.

/// A teacher's cohort/section (T-074). `teacherId` is the sole owner — no co-teaching, no
/// shared classes (Assumption A14).
///
/// Documented choice for deleting a class that still has students assigned (T-074 "your
/// call, document it — block or reassign"): BLOCKED. `DELETE /api/teacher/classes/:id`
/// (see `teacherClasses.routes.ts`) returns 409 if any `User.classId` still points at
/// this class, rather than silently reassigning or orphaning those students. Reasoning:
/// per Assumption A14 a student's class membership is meant to be permanent/stable
/// (changeable only via explicit teacher/admin action, never as a side effect of an
/// unrelated delete), and there is no "which OTHER class should they land in instead"
/// signal available to guess safely — silently picking one would be more surprising than
/// asking the teacher to first move/remove those students via the existing Admin user
/// panel (T-070) or a future dedicated reassignment tool. Deleting an EMPTY class (no
/// students) is always allowed with no extra confirmation. Content-to-class assignment
/// (T-075) doesn't exist yet at this task's scope, so there's no assigned-content case to
/// fold into this rule yet.
model Class {
  id        String   @id @default(uuid())
  name      String
  teacherId String
  teacher   User     @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  // Students currently assigned to this class (T-074) — see `User.classId`'s doc comment
  // for the "exactly one class, whole lifetime" rule this enforces at the app layer (not
  // the DB layer, which only enforces "at most one" via the plain scalar FK).
  students  User[]   @relation("ClassStudents")
  createdAt DateTime @default(now())

  @@map("classes")
}

/// Objective question types supported by the MVP test engine (T-007). Content types
/// added by later phases (Reading passages, Listening audio, Writing essays, Speaking)
/// are additional `QuestionType` values layered on later per PROJECT_PLAN Guiding
/// Principle 6 ("one engine, extended over time") — not modeled yet.
enum QuestionType {
  multipleChoice
  trueFalse
  fillBlank
  /// Free-text essay response (T-042/Assumption A3) — graded manually by the teacher
  /// (`Answer.manualScore`/`manualComment`), never auto-graded. See `Question.essayMaxScore`
  /// for the point scale a teacher grades against.
  essay
  /// Spoken response (T-052–T-056, Phase 8) — the ONLY AI-graded content type in this
  /// product (PROJECT_PLAN Assumption A3). A student records an in-browser audio answer
  /// within `Question.allowedResponseSeconds`; the recording + a client-generated draft
  /// transcript are graded via the server's `AIGradingProvider` (T-051,
  /// `server/src/grading/`), storing the result on `Answer.speakingAiScore`/
  /// `speakingAiFeedback`. A teacher may then override that score/feedback exactly like
  /// essay's manual grading, reusing the SAME `Answer.manualScore`/`manualComment`
  /// columns (T-055) — see those fields' doc comment below.
  speaking
}

/// The kind of `Test` this is (T-036/T-038, Assumption A4). `generic` (default) is every
/// plain test from T-007 onward — this migration backfills every existing row to
/// `generic`, so nothing about any test authored before T-036 changes behavior. See each
/// value's own call site for what it unlocks:
/// - `unitTest` (T-036): tagged to a `Unit` (`Test.unitId`, T-018) and gated behind
///   `Test.published` for student visibility (see that field's doc comment).
/// - `vocabularyCheck` (T-038): auto-generated by
///   `server/src/lib/vocabularyCheckGenerator.ts`, always `timeLimitMinutes: 15`, and
///   gated behind a `TestAssignment` row per target student rather than `published`
///   (see `TestAssignment`'s doc comment for why these two gating mechanisms differ).
/// - `listeningTest` / `mockTest`: reserved per Assumption A4 for later phases (T-040/
///   T-041 Listening, T-045 Mock Test) — not populated by any code in this batch.
enum TestType {
  generic
  unitTest
  vocabularyCheck
  listeningTest
  mockTest
}

/// A test authored by a teacher. Kept minimal for T-007 — fields like `testType`
/// (generic/unitTest/vocabularyCheck/...) still belong to the later backlog tasks that
/// actually need them (T-036, ...). `unitId` (T-018) is the exception: added now because
/// T-018's acceptance criteria explicitly requires "a Test can optionally be tagged with
/// a Unit" — see `Unit`'s doc comment below for why tagging (not the full "Unit Test"
/// feature) is in scope here.
///
/// `timeLimitMinutes` (T-012 "your call, keep it simple"): optional whole-minute limit
/// shown as a countdown to the student during the take-test runtime; `null` means
/// untimed. Deliberately just a plain nullable `Int` on `Test` rather than a separate
/// config table — every attempt of every variant of a test shares the same limit, so
/// there's nothing per-variant or per-attempt to store here.
///
/// `testType`/`published` (T-036): `testType` defaults to `generic` so every pre-existing
/// row is unaffected by this migration. `published` is the documented "your call" answer
/// to what makes a Unit Test "available" to students (T-036's acceptance criteria) —
/// deliberately a plain boolean the teacher flips explicitly (same UI as tagging a Unit,
/// in `TeacherTestEditorPage.tsx`), rather than deriving availability from "has an active
/// session" (T-010's `TestSession`) or "has ever been self-practiced" (T-040): a teacher
/// may want to finish authoring/reviewing a Unit Test privately before any student can see
/// it, independent of whether/when a session or self-practice attempt exists. Only
/// meaningful for `testType: unitTest` today (every other type ignores it) but left as a
/// plain `Test`-level column, not `unitTest`-specific storage, in case a later phase wants
/// the same "teacher must explicitly publish" gate for another type.
model Test {
  id               String           @id @default(uuid())
  title            String
  teacherId        String
  teacher          User             @relation("TeacherTests", fields: [teacherId], references: [id], onDelete: Cascade)
  timeLimitMinutes Int?
  testType         TestType         @default(generic)
  published        Boolean          @default(false)
  // `SetNull` (not `Cascade`/`Restrict`): deleting a `Unit` should never take a teacher's
  // tests down with it, or block the delete — the test just becomes untagged.
  unitId           String?
  unit             Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  sections         Section[]
  variants         TestVariant[]
  sessions         TestSession[]
  attempts         Attempt[]
  // Per-student access grants for individually-generated tests (T-038's Vocabulary
  // Check) — see `TestAssignment`'s doc comment below.
  assignments      TestAssignment[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("tests")
}

/// Grants one student access to take a specific `Test` (T-038), independent of the
/// broader `published`-flag gate `unitTest` uses (`Test.published` doc comment above).
/// Documented choice for why Vocabulary Check needs a DIFFERENT gating mechanism than
/// Unit Test's simple boolean: a Vocabulary Check is generated FOR one or more specific
/// students (its question pool is literally drawn from THEIR OWN `FlashcardProgress`,
/// per Assumption A8) — a single shared "published" flag can't express "visible to
/// exactly these N students, not the whole class," so this is a proper many-to-many join
/// row instead: one row per (test, student) grant. A single-student generation creates
/// one row; a "group" generation creates one row per selected student, all pointing at
/// the SAME generated `Test` (they all get the identical question pool/variant pool,
/// drawn from the union of the group's studied vocabulary — see
/// `server/src/lib/vocabularyCheckGenerator.ts`). `server/src/routes/practice.routes.ts`'s
/// `POST /:testId/practice` checks this table for `testType: vocabularyCheck` tests
/// before creating an attempt, so an unassigned student can never start someone else's
/// Vocabulary Check even if they learn/guess its id.
model TestAssignment {
  id        String   @id @default(uuid())
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentTestAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([testId, studentId])
  @@map("test_assignments")
}

/// A curriculum unit (T-018), e.g. "Unit 3 — Family & Friends". `order` is an explicit
/// teacher-controlled sort key (curriculum units are always presented in syllabus
/// order, not alphabetically or by creation time), same pattern as `Section.order`.
///
/// Documented choice (T-018 "your call, document it — global or per-teacher"): GLOBAL,
/// not owned by a specific teacher. This is a single small teaching business (see
/// PROJECT_PLAN.md — no multi-tenant/separate-schools scenario anywhere in the
/// requirements), so "Unit 3" means the same curriculum unit no matter which teacher is
/// looking at it, and every teacher account should see and manage the same shared list.
/// If that assumption ever changes, adding a `teacherId` column later is a small,
/// backwards-compatible migration — nothing about the shape below forecloses it.
model Unit {
  id            String         @id @default(uuid())
  name          String
  order         Int
  tests         Test[]
  // Optional curriculum tag for a flashcard set (T-021/T-022) — same `SetNull`
  // reasoning as `Test.unitId` below: deleting a Unit should never take a teacher's
  // flashcard sets down with it.
  flashcardSets FlashcardSet[]
  // Optional curriculum tag for a Grammar topic (T-046) — same `SetNull` reasoning as
  // `flashcardSets` above.
  grammarTopics GrammarTopic[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("units")
}

/// An academic period / semester (T-018), e.g. "Semester 1 2026". Same "global, not
/// per-teacher" reasoning as `Unit` above — the school's semester calendar is one shared
/// fact, not a per-teacher preference. `startDate`/`endDate` are stored as UTC instants
/// representing local midnight in the fixed `Asia/Ho_Chi_Minh` timezone (PROJECT_PLAN
/// Assumption A5) — see `server/src/routes/curriculum.routes.ts`'s `parseHcmDate` for the
/// exact parsing convention every write path must go through.
///
/// Nothing here references `Test`/`Attempt` yet — T-018 only introduces the entity so
/// T-019's reporting engine has something to bucket by later; wiring an attempt to "which
/// period was it taken in" is derived at query time from `Attempt.startedAt` falling
/// within `[startDate, endDate)`, not a stored FK, since a period's dates can be edited
/// after the fact and a derived lookup never goes stale.
model AcademicPeriod {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academic_periods")
}

/// A section within a test, explicitly ordered (`order`) since a test always renders
/// its sections in a fixed sequence.
///
/// Reading (T-039) and Listening (T-040/T-041) content types are attached at the
/// SECTION level, not per-question (documented choice): a real reading passage or
/// listening clip is shared context for every question underneath it, so "one passage/
/// clip per section, N questions about it" mirrors how these are authored in practice
/// and avoids storing/repeating the same passage or audio URL on every question row.
/// Both sets of fields are optional/independent — a section may have neither, either, or
/// (unusually) both.
///
/// - `passageText`/`passageImageUrl` (T-039): plain/markdown-ish text plus an optional
///   image URL. No rich-text editor/sanitization is introduced — same "just a string,
///   rendered as-is" level of effort as every other free-text field in this schema.
/// - `audioUrl`/`maxPlayCount` (T-040/T-041): `audioUrl` follows the exact same
///   placeholder-URL convention already established by `FlashcardCard.audioUrl`
///   (T-021/T-026) — a plain URL string, no real hosting/streaming service, never
///   validated to actually resolve to playable audio. `maxPlayCount` bounds how many
///   times a STANDALONE (self-practice, T-040) student may press Play; `null` means
///   unlimited plays. During a LIVE session (T-041) `maxPlayCount` is irrelevant — the
///   student never gets a self-serve Play button at all, only the teacher's broadcast
///   Play (see `TestSession.mode` and `server/src/realtime/sessionRealtime.ts`'s
///   `teacher:playAudio` event) can start playback, so there is nothing to cap
///   client-side in that mode.
model Section {
  id              String     @id @default(uuid())
  testId          String
  test            Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  title           String
  order           Int
  passageText     String?
  passageImageUrl String?
  audioUrl        String?
  maxPlayCount    Int?
  questions       Question[]
  createdAt       DateTime   @default(now())

  @@map("sections")
}

/// A question within a section, explicitly ordered (`order`). `prompt` holds the
/// question text for every type.
///
/// Accepted-answer storage per type (documented per T-007's "your call, document it"):
/// - `multipleChoice` / `trueFalse`: correctness lives on the related `Choice` rows
///   (`isCorrect`). `trueFalse` is just a `multipleChoice`-shaped question restricted
///   to two choices ("True"/"False") at the application layer — no separate storage.
/// - `fillBlank`: no `Choice` rows are created at all; accepted answers are stored
///   directly on the question as `acceptedAnswers String[]` (rather than a separate
///   join table) because they're a flat list of interchangeable correct strings with
///   no other per-answer data (no `isCorrect` flag needed — every entry in the array
///   is, by definition, correct) and are always loaded together with the question.
///   Matching is case-insensitive at grading time (T-013), not enforced by the DB.
model Question {
  id                     String       @id @default(uuid())
  sectionId              String
  section                Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type                   QuestionType
  prompt                 String
  order                  Int
  acceptedAnswers        String[]     @default([])
  /// Only meaningful for `essay` (T-042): the point value a teacher grades this essay
  /// out of (`Answer.manualScore` must be between 0 and this). `null` for every other
  /// type. Defaults to 10 at creation time if an essay is created without specifying one
  /// (`teacherTests.routes.ts`) — a simple, documented default rather than forcing every
  /// essay question to have one configured before it can be saved.
  essayMaxScore          Int?
  /// Only meaningful for `speaking` (T-052): how many seconds the student is given to
  /// respond once they reach this question during a test, enforced by a visible
  /// client-side countdown that auto-stops the recording / auto-advances the question at
  /// expiry (`TakeTestPage.tsx`). `null` for every other type. Defaults to 60 at creation
  /// time if omitted (`teacherTests.routes.ts`), same "simple documented default" pattern
  /// as `essayMaxScore` above.
  allowedResponseSeconds Int?
  /// Only meaningful for `speaking` (T-052): an optional audio clip for the prompt
  /// itself (e.g. "listen to this question, then answer it aloud"), independent of the
  /// text `prompt` field above — a Speaking question may use either or both. Same
  /// placeholder-URL convention as `Section.audioUrl` (T-040): a plain URL string, never
  /// validated to resolve to real audio. Documented choice: this lives per-QUESTION
  /// (unlike Reading/Listening's per-SECTION `passageText`/`audioUrl`) because each
  /// Speaking question's prompt is its own distinct piece of content, not shared context
  /// across several questions the way one Reading passage or Listening clip is.
  promptAudioUrl         String?
  choices                Choice[]
  answers                Answer[]
  createdAt              DateTime     @default(now())

  @@map("questions")
}

/// A single answer option for a `multipleChoice` or `trueFalse` question. Not used for
/// `fillBlank` (see `Question.acceptedAnswers`).
model Choice {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int
  // `SetNull` (declared on `Answer.selectedChoice`, not here) so deleting a choice a
  // student already answered with doesn't cascade-delete their whole `Answer` row.
  answers    Answer[]

  @@map("choices")
}

/// A generated shuffle ordering ("mã đề") for an authored test (T-009). Stores only
/// *presentation order* — which question appears in which position, and which choice
/// appears in which position within that question. Correctness itself always lives on
/// `Choice.isCorrect`, looked up by id, so it is completely unaffected by shuffling:
/// grading (T-013, later) never needs to know a variant exists at all, it only needs
/// the choice id the student picked.
///
/// `layout` shape (documented here since Prisma's `Json` type can't express it in the
/// schema itself) — see `server/src/lib/variantShuffle.ts` for the matching TS type:
/// ```
/// {
///   sections: Array<{ sectionId: string; questionIds: string[] }>;
///   choiceOrder: Record<string, string[]>; // questionId -> shuffled choice ids
/// }
/// ```
/// Documented choice (T-009 "your call, document it"): only *question order within
/// each section* and *choice order within each question* are shuffled. Section order
/// itself is left as authored, since sections typically carry meaning (e.g. "Reading",
/// "Listening") that shouldn't be scrambled relative to each other.
model TestVariant {
  id        String    @id @default(uuid())
  testId    String
  test      Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  code      String
  layout    Json
  createdAt DateTime  @default(now())
  attempts  Attempt[]

  @@unique([testId, code])
  @@map("test_variants")
}

/// Status of a `TestSession` (T-010). `closed` sessions no longer accept new joins.
enum SessionStatus {
  active
  closed
}

/// Distinguishes a teacher-run QR/in-class session from a student-initiated home
/// self-practice session (T-040/T-041, documented choice). `live` is every session
/// created by the existing teacher flow (`POST /tests/:testId/sessions`,
/// unchanged/default) — this is what T-041's teacher-controlled synchronized Listening
/// playback applies to. `selfPractice` sessions are created lazily by
/// `server/src/routes/practice.routes.ts` the first time ANY student requests to
/// self-practice a given test (one shared `selfPractice` session per `Test`, found-or-
/// created, never closed) — Listening sections behave per T-040 there (student's own
/// enabled Play button, optionally capped by `Section.maxPlayCount`) instead of T-041's
/// teacher-broadcast-only behavior. Every other part of the test-taking engine (grading,
/// tab-switch detection, essay review, ...) behaves identically regardless of `mode` —
/// this field ONLY gates Listening playback control, per Guiding Principle 6 ("one
/// engine, extended over time," not a parallel system for self-practice).
enum SessionMode {
  live
  selfPractice
}

/// A live/joinable "session" a teacher starts for one of their tests (T-010): a unique
/// join token (embedded in the QR code's join URL) plus a short manual-entry fallback
/// code for when scanning isn't possible.
///
/// Documented choice (T-010 "your call, document it"): a session's token stops working
/// for new joins in TWO cases — (1) the teacher explicitly closes it, or (2) the
/// teacher starts a new session for the same test, which automatically closes any
/// other still-active session(s) for that test. Either path sets `status: closed` (and
/// `closedAt`); the public join-token-check endpoint then rejects it.
model TestSession {
  id         String        @id @default(uuid())
  testId     String
  test       Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  joinToken  String        @unique
  manualCode String
  status     SessionStatus @default(active)
  /// `live` (default) vs `selfPractice` — see `SessionMode`'s doc comment above.
  mode       SessionMode   @default(live)
  createdAt  DateTime      @default(now())
  closedAt   DateTime?
  attempts   Attempt[]

  @@map("test_sessions")
}

/// Status of an `Attempt` (T-011/T-012). `inProgress` accepts answer autosaves;
/// `submitted` is terminal — every write endpoint that touches an attempt's answers
/// re-checks this server-side (not just trusting the client to stop sending requests)
/// so a submitted attempt can never be edited afterward, per T-012's acceptance
/// criteria ("verify server-side too, not just client-side").
enum AttemptStatus {
  inProgress
  submitted
}

/// One student's attempt at one `TestSession` (T-011), pinned to a single
/// auto-assigned `TestVariant` for the lifetime of the attempt (T-011/A7: round-robin
/// assignment, see `server/src/routes/sessions.routes.ts`). `@@unique([sessionId,
/// studentId])` is what makes "join" idempotent — re-opening the join link (or a
/// duplicate request from e.g. React StrictMode's double-effect in dev) always resolves
/// back to the SAME attempt/variant instead of creating a second one or reassigning a
/// different variant partway through.
///
/// Score fields (`correctCount`/`totalCount`/`scorePercent`) are `null` until submitted
/// (T-013) — grading happens once, at submission, from the answers already persisted at
/// that moment, and is deterministic (re-deriving from the same stored `Answer` rows via
/// `server/src/lib/grading.ts` always yields the same numbers).
model Attempt {
  id               String        @id @default(uuid())
  sessionId        String
  session          TestSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  testId           String
  test             Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId        String
  student          User          @relation("StudentAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  variantId        String
  variant          TestVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  status           AttemptStatus @default(inProgress)
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  correctCount     Int?
  totalCount       Int?
  scorePercent     Float?
  /// Total time taken, in whole seconds (T-017): `submittedAt - startedAt`, computed and
  /// stored once at submission time (`attempts.routes.ts`'s submit handler) — never
  /// recomputed on read, so it can't drift if `startedAt`/`submittedAt` are ever
  /// inspected later. `null` until submitted.
  ///
  /// Documented choice (T-017 "your call, document it") for excluding abandoned
  /// attempts from the average: this schema has NO separate "abandoned" status — an
  /// attempt that's never submitted just stays `AttemptStatus.inProgress` forever with
  /// `timeTakenSeconds: null`. The average-time query (`teacherTests.routes.ts`'s
  /// `GET /tests` handler) filters on `status: 'submitted'` (equivalently, `timeTakenSeconds
  /// IS NOT NULL`), so an abandoned attempt is simply excluded rather than corrupting the
  /// average — no new enum value needed.
  timeTakenSeconds Int?
  /// Global tab-switch / exit detection (T-044), recorded once by the ONE shared
  /// take-test runtime (`client/src/pages/TakeTestPage.tsx`, per Guiding Principle 5) so
  /// every test type gets this for free. `tabSwitchCount` is a denormalized running
  /// total (avoids every reader having to `.length` the log array); `tabSwitchLog` holds
  /// the ISO timestamp of each detected `visibilitychange`/`blur` event, same
  /// "plain string array, no separate join table" convention as
  /// `Question.acceptedAnswers`. Both are append-only and only meaningful while
  /// `status: inProgress` — the record endpoint (`POST /api/attempts/:id/tab-switch`)
  /// rejects further writes once submitted, same server-side re-check convention as
  /// every other attempt-mutating endpoint in this file.
  tabSwitchCount   Int           @default(0)
  tabSwitchLog     String[]      @default([])
  answers          Answer[]

  @@unique([sessionId, studentId])
  @@map("attempts")
}

/// One question's stored response within an `Attempt` (T-012/T-013). Exactly one of
/// `selectedChoiceId` (multipleChoice/trueFalse) or `textAnswer` (fillBlank) is
/// meaningful per question, mirroring the type-dependent storage already established by
/// `Question`/`Choice`. `isCorrect` stays `null` until the attempt is submitted (T-013
/// grades every question — answered or not — exactly once, at submit time); an
/// unanswered question still gets an `Answer` row after submission (both fields `null`,
/// `isCorrect: false`) so every question has exactly one graded row for the result/report
/// views (T-014), never a gap a UI has to special-case.
///
/// `@@unique([attemptId, questionId])` makes autosave an upsert: re-saving the same
/// question just overwrites the prior value, so "save on change or interval" can never
/// create duplicate answer rows for one question.
model Answer {
  id                  String    @id @default(uuid())
  attemptId           String
  attempt             Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId          String
  question            Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedChoiceId    String?
  selectedChoice      Choice?   @relation(fields: [selectedChoiceId], references: [id], onDelete: SetNull)
  textAnswer          String?
  isCorrect           Boolean?
  /// Manual essay grading (T-042). Both stay `null` until a teacher grades this answer
  /// via `PATCH /api/teacher/attempts/:attemptId/answers/:questionId/grade` — only
  /// meaningful when the underlying `Question.type` is `essay` (never set for any other
  /// type). `isCorrect` above is deliberately left `null` forever for an essay answer
  /// (there is no auto-graded pass/fail concept for free text) — `manualScore` out of the
  /// question's `essayMaxScore` is the only score that exists for it, and is displayed
  /// alongside (not merged into) `Attempt.correctCount`/`scorePercent`, which only ever
  /// reflect auto-gradable questions. See `attempts.routes.ts`'s submit handler doc
  /// comment for the full reasoning.
  manualScore         Float?
  manualComment       String?
  /// Speaking (T-052–T-056). `speakingAudioData` is the student's recorded answer,
  /// stored as a base64 `data:` URL (documented local storage convention — no real
  /// cloud/object storage exists in this build, see `attempts.routes.ts`'s module doc
  /// comment; a real deployment would swap this for a hosted URL without changing any
  /// other field here). `speakingTranscript` is the draft transcript generated
  /// client-side via the Web Speech API (T-053) — an empty string (never `null` once
  /// actually submitted) if the browser doesn't support it or no speech was detected,
  /// per T-053's "submitting still works" acceptance criteria. `speakingAiScore`/
  /// `speakingAiFeedback` are the ORIGINAL grade from the currently-registered
  /// `AIGradingProvider` (Mock, T-051), computed once at submission (T-054) and NEVER
  /// overwritten afterward — re-submitting a Speaking answer for the same question is
  /// rejected outright by `attempts.routes.ts` specifically so this original AI verdict
  /// is never silently lost. `speakingSubmittedAt` doubles as BOTH "has this been
  /// submitted yet" and the resubmission lock. A teacher's override for Speaking
  /// (T-055) reuses the SAME `manualScore`/`manualComment` columns above as essay's
  /// manual grading (not separate columns) — the teacher-set value wins once present,
  /// identical "teacher value wins" rule for both question types, see
  /// `AttemptResultQuestionDTO`'s doc comment in `@platform/shared`.
  speakingAudioData   String?
  speakingTranscript  String?
  speakingAiScore     Float?
  speakingAiFeedback  String?
  speakingSubmittedAt DateTime?
  /// T-064: when the student's response window actually started, per the server (set by
  /// `POST .../speaking-window/start`, called by the client the moment it first shows
  /// this question's countdown — first call wins, never overwritten). Enforces
  /// `Question.allowedResponseSeconds` server-side rather than trusting the client-only
  /// countdown, which was spoofable (a direct API call could submit an arbitrarily late
  /// "recording" for a short window with no pushback). `null` until the start signal
  /// arrives; a question with no `allowedResponseSeconds` configured never needs one.
  speakingWindowStartedAt DateTime?
  updatedAt           DateTime  @updatedAt

  @@unique([attemptId, questionId])
  @@map("answers")
}

// --- Vocabulary & Flashcards (T-021) -------------------------------------------------
// Phase 3 core: a teacher-owned collection of vocabulary words (`FlashcardSet` /
// `FlashcardCard`) plus per-student familiarity tracking (`FlashcardProgress`). Every
// exercise sub-type built in this same batch (T-024 fill-blank, T-025 unscramble, T-026
// listen-and-type, T-027 IPA-to-word) reads `FlashcardCard` and writes
// `FlashcardProgress` — see that model's doc comment for why there's no separate
// per-exercise-type log yet.

/// A student's familiarity level for one card (T-021/T-023). `known` is the "mastered"
/// end of the scale; `new` is the default for a card never reviewed at all (no row
/// exists yet — see `FlashcardProgress`'s doc comment on how `new` without a row differs
/// from `new` as an explicit status).
enum FlashcardProgressStatus {
  new
  learning
  known
}

/// A teacher-owned collection of vocabulary words (T-021), optionally tagged to a
/// curriculum `Unit` (T-018) — same optional-tag pattern as `Test.unitId`, including the
/// `SetNull` on unit delete.
model FlashcardSet {
  id        String          @id @default(uuid())
  name      String
  teacherId String
  teacher   User            @relation("TeacherFlashcardSets", fields: [teacherId], references: [id], onDelete: Cascade)
  unitId    String?
  unit      Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  cards     FlashcardCard[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("flashcard_sets")
}

/// One vocabulary word/card within a `FlashcardSet` (T-021), explicitly ordered
/// (`order`) — same convention as `Section`/`Question`. Only `term`/`meaning` are
/// required; every other field is optional per T-021's acceptance criteria ("fields may
/// be optional").
///
/// `exampleSentence` (documented choice, added ahead of T-024 since no such field
/// existed yet): an optional sentence using this word, with the literal substring
/// `___` (three underscores) marking where the word is blanked out for the
/// fill-in-the-blank exercise (T-024). Validated at authoring time
/// (`teacherFlashcards.routes.ts`) to always contain that marker when present. A card
/// with no `exampleSentence` is simply skipped by that exercise type (T-024's
/// acceptance criteria), never a hard error.
///
/// `audioUrl` convention (documented choice for T-026): a plain URL string the teacher
/// supplies, exactly like `imageUrl` — there is no audio hosting/TTS service built or
/// needed here, so this is content-authoring data, not a third-party integration (no
/// `INTEGRATIONS_TODO.md` entry). Seed/demo data (`prisma/seed.ts`) uses placeholder
/// URLs that don't resolve to real audio; the listen-and-type exercise (T-026) only
/// requires the field to be non-null to consider a card eligible — it never validates
/// server-side that the URL actually serves playable audio.
///
/// `synonyms` (documented choice for T-024): fill-in-the-blank's "any configured
/// alternates" (per its acceptance criteria) are this card's `synonyms` list — reused
/// rather than introducing a second free-form "alternate answers" field, since T-021's
/// schema task didn't call for one and a synonym is, by definition, an acceptable
/// alternate word for the blank.
model FlashcardCard {
  id                  String                     @id @default(uuid())
  setId               String
  set                 FlashcardSet               @relation(fields: [setId], references: [id], onDelete: Cascade)
  term                String
  meaning             String
  ipa                 String?
  imageUrl            String?
  audioUrl            String?
  exampleSentence     String?
  synonyms            String[]                   @default([])
  antonyms            String[]                   @default([])
  order               Int
  progress            FlashcardProgress[]
  sentenceSubmissions VocabSentenceSubmission[]
  /// Per-attempt exercise/activity log (T-030) — see `FlashcardExerciseAttempt`'s doc
  /// comment below.
  exerciseAttempts    FlashcardExerciseAttempt[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@map("flashcard_cards")
}

/// One student's familiarity/status for one `FlashcardCard` (T-021). A row is created
/// lazily on first interaction (study-mode marking in T-023, OR the first exercise
/// attempt in T-024–T-027) — a card with no row yet is treated as `new` by every reader,
/// so "never reviewed" and "explicitly marked new" are indistinguishable by design (no
/// meaningful product difference between them).
///
/// Documented choice: this single row IS "exercise progress" for every exercise type in
/// this batch — there is no separate per-exercise-type attempt log here (that level of
/// detail, e.g. "how many fill-blank attempts with what accuracy", is explicitly T-030's
/// job, not T-021's). T-023's direct study-mode marking and T-024–T-027's
/// answer-correctness-driven updates both read/write the exact same row per student+card
/// — see `server/src/lib/flashcardProgress.ts`'s `advanceStatus` for the shared
/// status-transition rule the exercise paths use (study mode sets the status directly,
/// since the student is explicitly choosing it there).
///
/// `@@unique([cardId, studentId])` makes every write an upsert — one row per
/// student+card, same pattern as `Answer.@@unique([attemptId, questionId])`.
model FlashcardProgress {
  id             String                  @id @default(uuid())
  cardId         String
  card           FlashcardCard           @relation(fields: [cardId], references: [id], onDelete: Cascade)
  studentId      String
  student        User                    @relation("StudentFlashcardProgress", fields: [studentId], references: [id], onDelete: Cascade)
  status         FlashcardProgressStatus @default(new)
  lastReviewedAt DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([cardId, studentId])
  @@map("flashcard_progress")
}

/// A student's free-text "use this word in a sentence" submission (T-029). Never
/// AI-graded (PROJECT_PLAN Assumption A3 scopes AI grading to Speaking only) — grading
/// here is a simple heuristic only (`containsWord`, computed once at submit time by
/// `server/src/lib/vocabSentence.ts` and stored alongside the raw text) and is never
/// used to block or reject the submission, only to give the student immediate
/// informational feedback and let a teacher skim for words nobody used correctly.
/// Append-only: a student may submit more than one sentence for the same card over time
/// (e.g. retrying), so there is no `@@unique([cardId, studentId])` here unlike
/// `FlashcardProgress` — every submission is its own row, ordered by `createdAt`.
model VocabSentenceSubmission {
  id           String        @id @default(uuid())
  cardId       String
  card         FlashcardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  studentId    String
  student      User          @relation("StudentVocabSentenceSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  sentence     String
  containsWord Boolean
  createdAt    DateTime      @default(now())

  @@map("vocab_sentence_submissions")
}

// --- Vocabulary/exercise progress tracking (T-030) -----------------------------------

/// Every vocabulary "activity" type that can produce a correct/incorrect verdict on one
/// card, mirroring `VocabExerciseType` (T-024-027) plus `'matching'` (T-028),
/// `'sentence'` (T-029, verdict = `VocabSentenceSubmission.containsWord`), and the two
/// vocab games `'spaceShooter'`/`'runner'` (T-034/T-035) — see `@platform/shared`'s
/// `VocabActivityType` for the matching TS union (string values kept identical, same
/// "Prisma enum can't import a TS union" note as `Role`/`UserRole`).
enum VocabActivityType {
  fillBlank
  unscramble
  listenAndType
  ipaToWord
  matching
  sentence
  spaceShooter
  runner
}

/// Per-attempt vocabulary exercise/activity log (T-030), added specifically because
/// `FlashcardProgress` (above) only ever holds ONE current status per student+card — it
/// is overwritten on every check, so there is no way to answer "how many fill-blank
/// attempts has this student made, with what accuracy" from it alone (only "what's their
/// status right now"). Rather than retrofitting history onto `FlashcardProgress` (which
/// would mean migrating every existing status transition into a reconstructed log that
/// doesn't actually exist), this is a lightweight, append-only, ADDITIVE log: every
/// exercise-check/matching-complete/sentence-submit/game-complete endpoint writes one row
/// here going forward, alongside (not instead of) its existing `FlashcardProgress`
/// upsert. No backfill of pre-T-030 history is attempted or needed — T-030's acceptance
/// criteria only asks for progress tracking from here on, and `FlashcardProgress.status`
/// still answers "known/learning/new right now" for cards practiced before this log
/// existed.
///
/// Deliberately NOT `@@unique` on any column combination — unlike `FlashcardProgress`,
/// this is a full history, so the same student may answer the same card via the same
/// exercise type more than once over time, and every attempt gets its own row.
model FlashcardExerciseAttempt {
  id        String            @id @default(uuid())
  cardId    String
  card      FlashcardCard     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  studentId String
  student   User              @relation("StudentFlashcardExerciseAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  type      VocabActivityType
  correct   Boolean
  createdAt DateTime          @default(now())

  // Read patterns this indexes for: "this student's stats, optionally per type"
  // (T-030), and "every attempt in a date range" (T-032/T-033 month/year ranking, via
  // `createdAt` alone — a plain b-tree index already covers a range scan, no composite
  // needed).
  @@index([studentId, type])
  @@index([cardId])
  @@index([createdAt])
  @@map("flashcard_exercise_attempts")
}

// --- Grammar module (T-046) ----------------------------------------------------------
// Phase 7: theory content + practice exercises + a per-attempt log for Grammar topics.
//
// Documented schema choice (T-046 "your call, document it clearly since it affects
// T-048"): `GrammarExercise`/`GrammarChoice` MIRROR `Question`/`Choice`'s exact shape —
// including reusing the very same `QuestionType` enum — as a fully PARALLEL set of
// models, rather than adding a nullable `sectionId`-free path onto `Question` itself (the
// "FK linking a Question-shaped table tagged as grammar" alternative the backlog also
// offered). Reasons:
//   1. `Question` is always owned by a `Section` of a `Test`, which is always owned by a
//      `TestSession`/QR-join/variant-shuffle flow. Grammar practice has NONE of that — a
//      student attempts a topic's exercises directly, anytime, with no session/join
//      concept at all, exactly like the Flashcard exercises (T-024–T-027) pattern, not
//      the Test-attempt pattern. Making `Question.sectionId` optional just to attach a
//      question to a `GrammarTopic` instead would be a non-additive, invasive change to
//      the core Test engine that Guiding Principle 6 explicitly warns against forcing.
//   2. `server/src/lib/grading.ts`'s `gradeAnswer` is ALREADY a pure, structural function
//      over `{ id, type, choices: {id, isCorrect}[], acceptedAnswers }` +
//      `{ selectedChoiceId, textAnswer }` shapes, with zero dependency on the real
//      `Question`/`Answer` Prisma models. `GrammarExercise`/`GrammarChoice` rows satisfy
//      that exact same shape, so T-048 calls the IDENTICAL grading function T-013 uses —
//      zero duplicated grading rules — without needing a shared table.
// `essay` remains a valid `QuestionType` value at the DB level (the enum isn't
// re-declared), but `teacherGrammar.routes.ts` rejects it at the validation layer:
// Grammar practice is objective-only per T-048's acceptance criteria (no manual-grading
// UI exists for Grammar).

/// A Grammar topic (T-046): theory content plus its practice exercises. Teacher-owned
/// (`teacherId`) for authoring rights — same ownership pattern as `FlashcardSet` — while
/// every topic is readable by every student (T-047), same "no enrollment concept"
/// convention already used for `FlashcardSet`/`Unit`.
model GrammarTopic {
  id            String                   @id @default(uuid())
  title         String
  teacherId     String
  teacher       User                     @relation("TeacherGrammarTopics", fields: [teacherId], references: [id], onDelete: Cascade)
  // Optional curriculum tag (T-018) — same optional-tag + `SetNull` pattern as
  // `Test.unitId`/`FlashcardSet.unitId`.
  unitId        String?
  unit          Unit?                    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  /// Theory content (T-047): plain/markdown-ish text, paragraphs separated by a blank
  /// line — same "just a string, rendered as-is, no rich-text editor/sanitization"
  /// convention already established by `Section.passageText`.
  theoryContent String
  exercises     GrammarExercise[]
  attempts      GrammarExerciseAttempt[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@map("grammar_topics")
}

/// One practice exercise within a `GrammarTopic` (T-046/T-048), explicitly ordered
/// (`order`) — same convention as `Section`/`Question`. Mirrors `Question`'s exact
/// type/storage split (see this section's module doc comment above): `multipleChoice`/
/// `trueFalse` correctness lives on `GrammarChoice.isCorrect`; `fillBlank` has no choice
/// rows and stores its accepted answers directly as `acceptedAnswers String[]`, matched
/// case-insensitively at grading time by the same `lib/grading.ts#gradeAnswer` T-013
/// uses.
model GrammarExercise {
  id              String                   @id @default(uuid())
  topicId         String
  topic           GrammarTopic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type            QuestionType
  prompt          String
  order           Int
  acceptedAnswers String[]                 @default([])
  choices         GrammarChoice[]
  attempts        GrammarExerciseAttempt[]
  createdAt       DateTime                 @default(now())

  @@map("grammar_exercises")
}

/// A single answer option for a `multipleChoice`/`trueFalse` `GrammarExercise`. Not used
/// for `fillBlank` — same split as `Choice`.
model GrammarChoice {
  id         String                   @id @default(uuid())
  exerciseId String
  exercise   GrammarExercise          @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean                  @default(false)
  order      Int
  // `SetNull` (declared on `GrammarExerciseAttempt.selectedChoice`, not here) — same
  // "don't cascade-delete a student's already-graded attempt" reasoning as `Choice`.
  attempts   GrammarExerciseAttempt[]

  @@map("grammar_choices")
}

/// Per-attempt Grammar exercise log (T-048), one row per submission — append-only, same
/// "full history, not a single overwritten status" convention as `FlashcardExerciseAttempt`
/// (T-030), which this deliberately mirrors: a student may retry the same exercise, and
/// T-050's reporting needs to bucket by WHEN each attempt happened (week/month/quarter/
/// semester/year), not just latest state. `isCorrect` is computed synchronously at
/// submission time via `lib/grading.ts#gradeAnswer` — the exact same function T-013 uses
/// for Test answers (see this section's module doc comment for why that's possible
/// without sharing a table).
///
/// `topicId` is a deliberate denormalization of `exercise.topicId` (the exercise's own
/// FK already implies it) — kept directly on this row so T-050's reporting can bucket/
/// filter by topic without an extra join on every report query, same "cheap, documented
/// denormalization" trade-off already used elsewhere in this schema (e.g.
/// `Attempt.timeTakenSeconds` being computed once and stored rather than derived on read).
///
/// `selectedChoiceId`/`textAnswer` are both `null` for a game-round batch submission
/// (T-049, `POST /grammar-topics/:topicId/games/:gameType/complete`) — that endpoint only
/// reports an aggregate correct/incorrect verdict per exercise touched during the round,
/// not which exact choice was clicked, same "client already knows both sides, only the
/// verdict is persisted" convention as the vocab games' `CompleteVocabActivityRequest`.
model GrammarExerciseAttempt {
  id               String          @id @default(uuid())
  topicId          String
  topic            GrammarTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         GrammarExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  studentId        String
  student          User            @relation("StudentGrammarExerciseAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  selectedChoiceId String?
  selectedChoice   GrammarChoice?  @relation(fields: [selectedChoiceId], references: [id], onDelete: SetNull)
  textAnswer       String?
  isCorrect        Boolean
  createdAt        DateTime        @default(now())

  // Read patterns this indexes for (T-050): "this student's stats, optionally per
  // topic" and "every attempt in a date range" (period-bucketing) — same indexing
  // rationale as `FlashcardExerciseAttempt` above.
  @@index([studentId, topicId])
  @@index([topicId])
  @@index([createdAt])
  @@map("grammar_exercise_attempts")
}

// --- Site-wide settings (T-067, Phase 10 Vietnamese localization) -------------------
// A single global, admin-controlled setting: the current UI language. This is NOT a
// per-user preference and there is NO public switcher anywhere in the product
// (PROJECT_PLAN Guiding Principle 3, Assumption A13) — every visitor, logged in or not,
// sees the same admin-chosen language.

/// The two supported UI languages (Assumption A13). Mirrors the `SiteLanguage` string
/// union this task also adds to `@platform/shared` — same "Prisma enum can't import a TS
/// union, string values match exactly" convention as `Role`/`UserRole`.
enum SiteLanguage {
  en
  vi
}

/// Singleton settings row (T-067). `id` is always the fixed string `"singleton"` — there
/// is exactly one row, ever; every read/write targets `id: SETTINGS_ID` (see the
/// matching constant in `server/src/routes/settings.routes.ts`) rather than modeling
/// this as a keyed table with lookups. `language` defaults to `en` per Assumption A13
/// ("English is the default until an admin changes it").
///
/// THIS TASK (T-067) ONLY BUILDS THE READ SIDE: `GET /api/settings` (public, no auth —
/// see `server/src/routes/settings.routes.ts`) so even a logged-out visitor sees the
/// current language before logging in. The WRITE side is explicitly a FUTURE task
/// (T-072, Admin Settings page — someone else's job) — writing to this setting is simply
/// `prisma.settings.upsert({ where: { id: SETTINGS_ID }, update: { language }, create: {
/// id: SETTINGS_ID, language } })`, gated behind `requireAuth, requireRole('admin')` on a
/// new `PATCH /api/admin/settings` route. Nothing about this shape needs to change for
/// that endpoint to be trivial to add.
model Settings {
  id        String       @id @default("singleton")
  language  SiteLanguage @default(en)
  updatedAt DateTime     @updatedAt

  @@map("settings")
}
